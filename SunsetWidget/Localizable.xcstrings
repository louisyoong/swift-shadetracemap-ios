  "strings" : {
    "--:--" : {
      "comment" : "A placeholder for the time remaining until the next sunrise, sunset, or sunrise.",
      "isCommentAutoGenerated" : true
    },
    "A live countdown to sunrise or sunset on a sun-arc graphic." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّ تنازلي مباشر حتى الشروق أو الغروب على رسم لقوس الشمس."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En live nedtælling til solopgang eller solnedgang på en solbue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Live-Countdown bis Sonnenauf- oder -untergang auf einem Sonnenbogen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta atrás en directo hasta el amanecer o el atardecer sobre un arco solar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte à rebours en direct jusqu'au lever ou au coucher du soleil sur un arc solaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitung mundur langsung menuju matahari terbit atau terbenam pada grafik busur matahari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太陽の弧のグラフィックで日の出・日の入りまでをリアルタイムでカウントダウン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태양 궤적 그래픽 위에 일출 또는 일몰까지 실시간 카운트다운을 표시합니다."
          }
        },
        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numeratio retrorsum ad ortum vel occasum solis in arcu solis."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kira detik langsung ke matahari terbit atau terbenam pada grafik lengkung matahari."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma contagem regressiva ao vivo até o nascer ou o pôr do sol em um arco solar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратный отсчёт до восхода или заката на дуге солнца."
          }
        },
        "ss" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubala lokubuyela emuva kuya ekuphumeni nome ekushoneni kwelilanga."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用太陽弧線圖即時倒數到日出或者日落。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太阳弧线图实时倒数至日出或日落。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
