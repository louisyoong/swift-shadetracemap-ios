    "No live compass sensor detected (simulators don't have one) - showing the sun's bearing from true north instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على مستشعر بوصلة (لا تحتوي أجهزة المحاكاة على واحد) – يتم عرض اتجاه الشمس من الشمال الحقيقي بدلًا من ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kompassensor fundet (simulatorer har ingen) – viser i stedet solens retning fra geografisk nord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Kompasssensor erkannt (Simulatoren haben keinen) – stattdessen wird die Richtung der Sonne ab geografisch Nord angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se detectó ningún sensor de brújula (los simuladores no tienen) – se muestra la dirección del sol desde el norte verdadero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun capteur de boussole détecté (les simulateurs n'en ont pas) – affichage de l'azimut du soleil par rapport au nord géographique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor kompas tidak terdeteksi (simulator tidak memilikinya) – menampilkan arah matahari dari utara sejati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパスセンサーが見つかりません（シミュレータには搭載されていません）。代わりに真北からの太陽の方位を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나침반 센서를 찾을 수 없습니다(시뮬레이터에는 없음). 대신 진북 기준 태양 방향을 표시합니다."
          }
        },
        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nullum sensorium pyxidis inventum est (simulatra id non habent) – loco eius directio solis a septentrione vero ostenditur."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada penderia kompas dikesan (simulator tidak memilikinya) – memaparkan arah matahari dari utara sebenar."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum sensor de bússola detectado (simuladores não têm) – mostrando a direção do sol a partir do norte verdadeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик компаса не обнаружен (в симуляторах его нет) – показано направление на солнце от истинного севера."
          }
        },
        "ss" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asikho sitfwebuli senkomba lesitfoliwe (ema-simulator awanaso) – sikhombisa indlela yelilanga kusukela enyakatfo yeliciniso."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搵唔到指南針感應器（模擬器冇呢樣嘢），改為顯示太陽相對正北嘅方位。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未检测到指南针传感器（模拟器没有此传感器），改为显示太阳相对正北的方位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未偵測到指南針感應器（模擬器沒有此感應器），改為顯示太陽相對正北的方位。"
          }
        }
      }
    },
