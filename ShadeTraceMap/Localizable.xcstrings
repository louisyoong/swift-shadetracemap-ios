    "Sun below horizon — no shadows right now." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشمس تحت الأفق — لا ظلال الآن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solen er under horisonten — ingen skygger lige nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne unter dem Horizont – gerade keine Schatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol bajo el horizonte — no hay sombras ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soleil sous l'horizon — pas d'ombres pour l'instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matahari di bawah cakrawala — tidak ada bayangan saat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太陽が地平線の下にあるため、現在は影がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태양이 지평선 아래에 있어 지금은 그림자가 없습니다."
          }
        },
        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol sub horizonte — nunc nullae umbrae."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matahari di bawah ufuk — tiada bayang buat masa ini."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol abaixo do horizonte — sem sombras agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Солнце за горизонтом — теней сейчас нет."
          }
        },
        "ss" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lilanga lingentasi kwemkhatsi — akukho titfunti njenje."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太陽喺地平線下面 — 而家冇影。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太阳在地平线以下 — 目前没有阴影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太陽在地平線以下 — 目前沒有陰影。"
          }
        }
      }
    },
