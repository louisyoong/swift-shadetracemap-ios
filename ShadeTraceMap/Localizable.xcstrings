    "Turn left %lld° to face the sun." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استدر %lld° إلى اليسار لمواجهة الشمس."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drej %lld° til venstre for at vende mod solen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehen Sie sich %lld° nach links, um zur Sonne zu blicken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira %lld° a la izquierda para mirar al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez de %lld° vers la gauche pour faire face au soleil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar ke kiri %lld° untuk menghadap matahari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左に%lld°回ると太陽の方を向きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태양을 향하려면 왼쪽으로 %lld° 도세요."
          }
        },
        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verte te %lld° sinistrorsum ut solem spectes."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusing ke kiri %lld° untuk menghadap matahari."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vire %lld° à esquerda para ficar de frente para o sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повернитесь на %lld° влево, чтобы смотреть на солнце."
          }
        },
        "ss" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phendvukela ngesencele nga-%lld° kute ubhekane nelilanga."
